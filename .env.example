# Copy this file to .env and fill in your real values.
# .env itself should stay untracked by git — see .gitignore.
#
# Find these in MantisProperty under Preferences > API.
MANTIS_AGENCY_ID=
MANTIS_API_KEY=

# Comma-separated list of listing types to sync. Defaults to "business"
# (accommodation/tourism businesses for sale) if left unset.
# Other Mantis listing types you may see referenced: residential, commercial,
# rental, land — check your Mantis account for the exact set that applies to you.
MANTIS_LISTING_TYPES=business

# Set to "true" to have the sync also pull sold listings from Mantis (each
# will come through with sold: true in listings.json). Needed for a "Sold"
# page — leave "false" if you only want current/active listings.
MANTIS_INCLUDE_SOLD=false

# Set to "true" to also pull archived listings.
MANTIS_INCLUDE_ARCHIVED=false
